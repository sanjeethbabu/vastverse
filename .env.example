# ---------- Email (required for the contact form) ----------
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=Vastverse website <you@gmail.com>
NOTIFY_TO=you@gmail.com
# Send visitors a short "we got your message" email
AUTO_REPLY=false

# ---------- Optional: Supabase storage (off while these are empty) ----------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Protects GET /api/admin/leads (only used when Supabase is on)
ADMIN_TOKEN=

# ---------- Local development ----------
CORS_ORIGINS=http://localhost:5173
# Frontend, only if the API is hosted on a different domain:
# VITE_API_URL=https://api.example.com

# ---------- Mr. Smart assistant (LangGraph workflow in backend/mr_smart) ----------
# xAI Grok API key from https://console.x.ai — kept on the server, never sent to the browser
XAI_API_KEY=
XAI_MODEL=grok-4
# Optional OpenAI-compatible endpoint override
# XAI_API_URL=https://api.x.ai/v1/chat/completions
